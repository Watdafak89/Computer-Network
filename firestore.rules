rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // This security rules file assumes the following data structures:
    //
    // Collection: students
    // Document ID: {userId} (must match request.auth.uid)
    // Fields:
    //   - uid: string (required, immutable, must equal userId / request.auth.uid)
    //   - studentId: string (required, 4..40 chars) - student ID code
    //   - name: string (required, 1..120 chars) - student display name
    //   - classRoom: string (required, 0..40 chars) - classroom label
    //   - heroClass: string (required, enum: 'paladin'|'mage'|'ranger'|'ninja')
    //   - level: int (required, 1..10) - rank level
    //   - xp: int (required, 0..1000000) - total experience points
    //   - unitsCleared: int (required, 0..6) - number of unit bosses cleared
    //   - badgeCount: int (required, 0..12) - unlocked badge count
    //   - arcadeHighScore: int (required, 0..1000000) - best Endless Arcade score
    //   - state: map (required, strictly bounded nested game progress state)
    //   - updatedAt: string (required, 0..30 chars) - YYYY-MM-DD display date
    //   - updatedAtServer: timestamp (required, must equal request.time)
    //   - createdAtServer: timestamp (optional on create, immutable on update;
    //     must equal request.time when supplied on create)
    //
    // Collection: customQuestions
    // Document ID: {docId} (auto-generated)
    // Fields:
    //   - unitId: int (required, 1..6) - target curriculum unit
    //   - q: string (required, 1..500 chars) - question prompt
    //   - options: list of 4 strings (required, each 1..500 chars) - answer choices
    //   - ans: int (required, 0..3) - zero-based correct option index
    //   - exp: string (required, 0..500 chars) - explanation text
    //   - createdAtServer: timestamp (required, must equal request.time)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if authenticated user owns the document path by UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify UID hasn't been tampered with on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that immutable fields are unchanged on update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate string type and inclusive length bounds
    function validString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Validate integer type and inclusive range bounds
    function validIntRange(val, minVal, maxVal) {
      return val is int && val >= minVal && val <= maxVal;
    }

    // Validate allowed RPG hero class enum
    function isValidHeroClass(heroClass) {
      return heroClass is string &&
        heroClass in ['paladin', 'mage', 'ranger', 'ninja'];
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    function isValidStudentProfile(profile) {
      return profile is map &&
        profile.keys().hasAll(['name', 'studentId', 'classRoom', 'heroClass', 'created']) &&
        profile.keys().hasOnly(['name', 'studentId', 'classRoom', 'heroClass', 'created']) &&
        validString(profile.name, 0, 120) &&
        validString(profile.studentId, 0, 40) &&
        validString(profile.classRoom, 0, 40) &&
        isValidHeroClass(profile.heroClass) &&
        profile.created is bool;
    }

    function isValidInventory(inv) {
      return inv is map &&
        inv.keys().hasAll(['potion', 'analyzer', 'clock', 'shield']) &&
        inv.keys().hasOnly(['potion', 'analyzer', 'clock', 'shield']) &&
        validIntRange(inv.potion, 0, 9999) &&
        validIntRange(inv.analyzer, 0, 9999) &&
        validIntRange(inv.clock, 0, 9999) &&
        validIntRange(inv.shield, 0, 9999);
    }

    function isValidUnitProgress(unitProg) {
      return unitProg is map &&
        unitProg.keys().hasAll(['labCleared', 'bossCleared', 'bestScore', 'stars']) &&
        unitProg.keys().hasOnly(['labCleared', 'bossCleared', 'bestScore', 'stars']) &&
        unitProg.labCleared is bool &&
        unitProg.bossCleared is bool &&
        validIntRange(unitProg.bestScore, 0, 100) &&
        validIntRange(unitProg.stars, 0, 3);
    }

    function isValidUnitProgressMap(upMap) {
      return upMap is map &&
        upMap.keys().hasAll(['1', '2', '3', '4', '5', '6']) &&
        upMap.keys().hasOnly(['1', '2', '3', '4', '5', '6']) &&
        isValidUnitProgress(upMap['1']) &&
        isValidUnitProgress(upMap['2']) &&
        isValidUnitProgress(upMap['3']) &&
        isValidUnitProgress(upMap['4']) &&
        isValidUnitProgress(upMap['5']) &&
        isValidUnitProgress(upMap['6']);
    }

    function isValidDailyState(daily) {
      return daily is map &&
        daily.keys().hasAll([
          'date', 'labsCompletedToday', 'bossesDefeatedToday',
          'bestComboToday', 'arcadeRunsToday', 'claimed'
        ]) &&
        daily.keys().hasOnly([
          'date', 'labsCompletedToday', 'bossesDefeatedToday',
          'bestComboToday', 'arcadeRunsToday', 'claimed'
        ]) &&
        validString(daily.date, 0, 20) &&
        validIntRange(daily.labsCompletedToday, 0, 1000) &&
        validIntRange(daily.bossesDefeatedToday, 0, 1000) &&
        validIntRange(daily.bestComboToday, 0, 1000) &&
        validIntRange(daily.arcadeRunsToday, 0, 1000) &&
        daily.claimed is list &&
        daily.claimed.size() <= 10 &&
        daily.claimed.hasOnly(['dq_lab', 'dq_boss', 'dq_combo', 'dq_arcade']);
    }

    function isValidStudentState(state) {
      return state is map &&
        state.keys().hasAll([
          'profile', 'xp', 'coins', 'hp', 'inventory', 'equipment',
          'badges', 'unitProgress', 'daily', 'arcadeHighScore', 'crt'
        ]) &&
        state.keys().hasOnly([
          'profile', 'xp', 'coins', 'hp', 'inventory', 'equipment',
          'badges', 'unitProgress', 'daily', 'arcadeHighScore', 'crt'
        ]) &&
        isValidStudentProfile(state.profile) &&
        validIntRange(state.xp, 0, 1000000) &&
        validIntRange(state.coins, 0, 10000000) &&
        validIntRange(state.hp, 0, 1000) &&
        isValidInventory(state.inventory) &&
        state.equipment is list &&
        state.equipment.size() <= 10 &&
        state.equipment.hasOnly([
          'golden_crimper', 'fiber_boots', 'packet_goggles', 'firewall_armor'
        ]) &&
        state.badges is list &&
        state.badges.size() <= 12 &&
        state.badges.hasOnly([
          'first_login', 'unit1_clear', 'unit2_clear', 'unit3_clear',
          'unit4_clear', 'unit5_clear', 'unit6_clear', 'combo_master',
          'perfect_crimper', 'shopaholic', 'arcade_hero', 'grand_champion'
        ]) &&
        isValidUnitProgressMap(state.unitProgress) &&
        isValidDailyState(state.daily) &&
        validIntRange(state.arcadeHighScore, 0, 1000000) &&
        state.crt is bool;
    }

    function isValidStudent(data, userId) {
      return hasRequiredFields([
          'uid', 'studentId', 'name', 'classRoom', 'heroClass',
          'level', 'xp', 'unitsCleared', 'badgeCount', 'arcadeHighScore',
          'state', 'updatedAt', 'updatedAtServer'
        ]) &&
        hasOnlyAllowedFields([
          'uid', 'studentId', 'name', 'classRoom', 'heroClass',
          'level', 'xp', 'unitsCleared', 'badgeCount', 'arcadeHighScore',
          'state', 'updatedAt', 'updatedAtServer', 'createdAtServer'
        ]) &&
        data.uid is string &&
        data.uid == userId &&
        validString(data.studentId, 4, 40) &&
        validString(data.name, 1, 120) &&
        validString(data.classRoom, 0, 40) &&
        isValidHeroClass(data.heroClass) &&
        validIntRange(data.level, 1, 10) &&
        validIntRange(data.xp, 0, 1000000) &&
        validIntRange(data.unitsCleared, 0, 6) &&
        validIntRange(data.badgeCount, 0, 12) &&
        validIntRange(data.arcadeHighScore, 0, 1000000) &&
        validString(data.updatedAt, 0, 30) &&
        data.updatedAtServer is timestamp &&
        data.updatedAtServer == request.time &&
        (!('createdAtServer' in data) || data.createdAtServer is timestamp) &&
        isValidStudentState(data.state);
    }

    function isValidCustomQuestion(data) {
      return hasRequiredFields([
          'unitId', 'q', 'options', 'ans', 'exp', 'createdAtServer'
        ]) &&
        hasOnlyAllowedFields([
          'unitId', 'q', 'options', 'ans', 'exp', 'createdAtServer'
        ]) &&
        validIntRange(data.unitId, 1, 6) &&
        validString(data.q, 1, 500) &&
        data.options is list &&
        data.options.size() == 4 &&
        validString(data.options[0], 1, 500) &&
        validString(data.options[1], 1, 500) &&
        validString(data.options[2], 1, 500) &&
        validString(data.options[3], 1, 500) &&
        validIntRange(data.ans, 0, 3) &&
        validString(data.exp, 0, 500) &&
        data.createdAtServer is timestamp &&
        data.createdAtServer == request.time;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Default deny for any unspecified collection or subcollection
    match /{document=**} {
      allow read, write: if false;
    }

    // Student profiles, saved game states, and class leaderboard query
    match /students/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
        isValidStudent(request.resource.data, userId) &&
        uidUnchanged() &&
        (!('createdAtServer' in request.resource.data) ||
          request.resource.data.createdAtServer == request.time);
      allow update: if isOwner(userId) &&
        isValidStudent(request.resource.data, userId) &&
        uidNotModified() &&
        areImmutableFieldsUnchanged(['uid', 'createdAtServer']);
      allow delete: if false;
    }

    // Custom quiz questions added for unit boss battles (append-only)
    match /customQuestions/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        isValidCustomQuestion(request.resource.data);
      allow update, delete: if false;
    }
  }
}
